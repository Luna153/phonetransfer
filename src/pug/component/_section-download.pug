//- section
mixin section-download()
  section.section.section-download#section-download
    //- .section-download__arc
    .wrap__inner
      .center
        h2.section-title 立即下載
      .section-download__wrap
        .section-download__wrap-box
          .section-download__icon
          .section-download__title.noto-400 行動銀行APP
          .section-download__wrap-content
            .section-download__qrcode
              img(src="images/qrcode-mobilebank.svg")
            .section-download__btns
              a(href="https://dmp.sinopac.com/DMP_SA/r/BB" rel='stylesheet').section-download__btn
                img(src="images/download-android.svg")
              a(href="https://dmp.sinopac.com/DMP_SA/r/BB" rel='stylesheet').section-download__btn
                img(src="images/download-ios.svg")
        .section-download__wrap-box
          .section-download__icon
          .section-download__title.noto-400 DAWHO APP
          .section-download__wrap-content
            .section-download__qrcode
              img(src="images/qrcode-dawho.svg")
            .section-download__btns
              a(href="https://dmp.sinopac.com/DMP_SA/r/AB" rel='stylesheet').section-download__btn
                img(src="images/download-android.svg")
              a(href="https://dmp.sinopac.com/DMP_SA/r/AB" rel='stylesheet').section-download__btn
                img(src="images/download-ios.svg")
